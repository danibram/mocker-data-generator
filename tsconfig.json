{
    "compilerOptions": {
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2020"],
        "outDir": "build",
        "rootDir": "src",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "strict": false,
        "strictNullChecks": true,
        "noImplicitAny": false,
        "noImplicitThis": false,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "pretty": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "src/**/*.spec.ts"]
}
